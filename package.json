{
  "name": "nextleek",
  "version": "4.0.0",
  "description": "Cordis-powered desktop command launcher",
  "author": "NextLeek Contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test tests/*.test.ts",
    "gates": "node scripts/gates/run.mjs",
    "check": "pnpm typecheck && pnpm gates && pnpm test",
    "build:win": "pnpm build && electron-builder --win zip --x64 --publish never",
    "build:mac": "pnpm build && electron-builder --mac zip --publish never",
    "build:linux": "pnpm build && electron-builder --linux tar.gz --publish never",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "lmdb": "3.4.2",
    "pinia": "3.0.3",
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "41.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright-core": "1.64.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10",
    "vue-tsc": "3.1.1"
  }
}
