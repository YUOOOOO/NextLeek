{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NextLeek",
  "version": "0.1.0",
  "identifier": "com.nextleek.creator",
  "build": {
    "beforeDevCommand": "pnpm --dir ../shell-ui dev",
    "beforeBuildCommand": "pnpm --dir ../shell-ui build",
    "frontendDist": "../../shell-ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NextLeek",
        "width": 680,
        "height": 72,
        "minWidth": 520,
        "minHeight": 72,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": "v1Compatible",
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NUUwNzREMTdGMjQ5MEIKUldRTFNmSVhUUWRlU0JwZWJDSVp5WjlMSWNFcWx2R3RoajFBVHAzM2NHRFEwbTRqdnB2dG9tQU8K",
      "endpoints": ["https://github.com/YUOOOOO/NextLeek/releases/latest/download/latest.json"]
    }
  }
}
