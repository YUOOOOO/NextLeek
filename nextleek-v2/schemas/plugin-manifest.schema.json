{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://nextleek.local/schemas/plugin-manifest.schema.json",
  "title":"NextLeek Declarative Plugin Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["id","name","version","entry","minCreatorVersion","capabilities","permissions"],
  "properties":{
    "$schema":{"type":"string"},
    "id":{"type":"string","pattern":"^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*){2,}$"},
    "name":{"type":"string","minLength":1},
    "version":{"type":"string"},
    "entry":{"type":"string","pattern":"^ui/"},
    "description":{"type":"string"},
    "author":{"type":"string"},
    "icon":{"type":"string","pattern":"^assets/"},
    "minCreatorVersion":{"type":"string"},
    "capabilities":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "permissions":{"type":"array","items":{"enum":["storage:local","network:https","filesystem:trusted"]},"uniqueItems":true},
    "navigation":{
      "type":"object",
      "additionalProperties":false,
      "properties":{
        "enabled":{"type":"boolean","default":false},
        "label":{"type":"string","minLength":1},
        "icon":{"type":"string","pattern":"^assets/"},
        "order":{"type":"integer","default":100}
      }
    }
  }
}
