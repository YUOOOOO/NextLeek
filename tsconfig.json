{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "@renderer/*": ["plugins/launcher/renderer/src/*"], "@/*": ["plugins/settings/src/*"], "@shared/*": ["plugins/ztools-shared/*"] },
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  }
}
